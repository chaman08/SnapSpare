{
  "name": "@snapspare/functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:emulator": "vitest run --config vitest.emulator.config.ts",
    "serve": "pnpm build && firebase emulators:start --only functions",
    "shell": "pnpm build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@sentry/node": "^8.42.0",
    "@snapspare/shared": "workspace:*",
    "exceljs": "^4.4.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "pdfkit": "^0.15.1",
    "typesense": "^1.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/pdfkit": "^0.13.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
