# Typesense connection (non-secret). Copy to .env.<firebase-project-id> for
# each environment — see https://firebase.google.com/docs/functions/config-env
# Defaults (in typesenseClient.ts) point at a local dev container.
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# Secrets — never put these in an .env file. Set with:
#   firebase functions:secrets:set TYPESENSE_ADMIN_API_KEY
#   firebase functions:secrets:set TYPESENSE_SEARCH_ONLY_API_KEY
# TYPESENSE_ADMIN_API_KEY: the cluster's admin key (indexing writes only).
# TYPESENSE_SEARCH_ONLY_API_KEY: a key scoped to search-only actions, created
# once in the Typesense dashboard/API — createSearchKey.ts and (Phase 14)
# createCatalogPartSearchKey.ts both derive a short-lived, per-session key
# from this one. Must have documents:search on BOTH the `listings` and
# `catalog_parts` collections (see packages/shared/src/search/
# catalogPartSearchCollectionSchema.ts) — a key scoped to `listings` only
# will fail every "Add listing" typeahead search with a 401.

# Phase 16: notifications (non-secret identifiers/config).
WHATSAPP_PHONE_NUMBER_ID=
MSG91_SENDER_ID=SNPSPR
MSG91_ROUTE=4
RESEND_FROM_EMAIL=notifications@snapspare.in

# Phase 16 secrets — never put these in an .env file. Set with:
#   firebase functions:secrets:set WHATSAPP_ACCESS_TOKEN
#   firebase functions:secrets:set MSG91_API_KEY
#   firebase functions:secrets:set RESEND_API_KEY
# WHATSAPP_ACCESS_TOKEN: WhatsApp Cloud API bearer token (Meta developer app).
# MSG91_API_KEY: MSG91 SMS API auth key.
# RESEND_API_KEY: Resend transactional email API key.
