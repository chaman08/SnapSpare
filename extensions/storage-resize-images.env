# Config for the "Resize Images" extension (firebase/storage-resize-images).
# Deploy with: firebase deploy --only extensions
#
# IMG_BUCKET is intentionally left for the deployer to fill in (or pass via
# `firebase ext:configure` / --params) since it's the project's Storage
# bucket name, which differs per Firebase project/environment and isn't
# committed anywhere else in this repo either (see apps/web/.env.example).
IMG_BUCKET=
IMG_SIZES=200x200,400x400,800x800
IMG_TYPE=webp
IMG_DELETE_ORIGINAL=false
FUNCTION_MEMORY=1024
LOCATION=asia-south1

# Don't resize objects that already exist in the bucket at install time —
# only newly uploaded images going forward. A backfill run over the whole
# bucket is a one-off op a human should trigger deliberately, not something
# every deploy should risk re-triggering (extension invocation costs).
DO_BACKFILL=false

# Only resize inside the public, buyer-facing image paths — see
# storage.rules for why these are the ones marked `allow read: if true`.
# Everything else (seller documents, return/dispute evidence, etc.) is
# never rendered as a responsive <img> and shouldn't cost extension
# invocations or storage.
INCLUDE_PATH_LIST=/sellers/*/listings/**,/reviews/**,/sellers/*/store/**

# Resized files sit next to the original (<name>_<width>x<width>.webp) —
# see apps/web/src/components/media/resizedImageUrl.ts, which derives the
# sibling filename from the original download URL. Changing this requires
# updating that file too.
RESIZED_IMAGES_PATH=
