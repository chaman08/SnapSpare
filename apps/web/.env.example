# Firebase web app config — copy from Firebase console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Web push (Phase 16) — Firebase console > Project settings > Cloud Messaging
# > Web configuration > generate a key pair. Also regenerates
# public/firebase-messaging-sw.js from the config above — see
# scripts/generate-fcm-sw.mjs (runs automatically before dev/build).
VITE_FIREBASE_VAPID_KEY=

# Set to "true" to connect the SDK to the local Firebase emulator suite
VITE_USE_EMULATORS=false

# When VITE_USE_EMULATORS=true, set this to "false" to make Auth skip the
# emulator and hit real Google OAuth instead (the emulator's Google sign-in
# is a fake form, not the real account picker), while Firestore/Functions/
# Storage stay emulated. Defaults to "true" (fully emulated) when unset.
VITE_USE_AUTH_EMULATOR=true

# App Check — reCAPTCHA Enterprise site key (Firebase console > App Check)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# App Check debug token for local dev only, never set in staging/prod.
# Generate one by running the app once with no token set — it will log a
# token to the console that you register in Firebase console > App Check > Debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=

# No Typesense host/port/API key is configured here on purpose: the
# `createSearchKey` callable returns the connection details (matching
# functions/.env.example's TYPESENSE_HOST/PORT/PROTOCOL) plus a short-lived
# scoped search key — see src/features/search/api/searchClient.ts.
