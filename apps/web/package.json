    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "firebase-admin": "^12.7.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.48.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
