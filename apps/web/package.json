{
  "name": "@snapspare/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate-sw": "node scripts/generate-sw.mjs",
    "dev": "node scripts/generate-sw.mjs && vite",
    "build": "node scripts/generate-sw.mjs && tsc -b && vite build",
    "build:prerender": "pnpm build && node scripts/generate-prerender-urls.mjs && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
